{
  "name": "rusty-view",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "rv",
  "sourceRoot": "apps/rusty-view/src",
  "tags": ["type:app", "scope:rusty-view"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/rusty-view",
        "browser": "apps/rusty-view/src/main.ts",
        "tsConfig": "apps/rusty-view/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/rusty-view/public"
          }
        ],
        "styles": [
          "libs/design-tokens/src/styles/tokens.css",
          "apps/rusty-view/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "rusty-view:build:production"
        },
        "development": {
          "buildTarget": "rusty-view:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "rusty-view:build",
        "port": 4200,
        "staticFilePath": "dist/apps/rusty-view/browser",
        "spa": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.app.json"
      }
    }
  }
}

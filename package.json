{
  "name": "rusty-view",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "nx serve rusty-view",
    "build": "nx run-many -t build --all",
    "build:rusty-view": "nx build rusty-view",
    "lint": "nx run-many -t lint --all",
    "lint:affected": "nx affected -t lint",
    "lint:tokens": "node tools/check-design-tokens.mjs",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "nx run-many -t test --all",
    "test:affected": "nx affected -t test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,html,css,scss,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,html,css,scss,json,md,yml,yaml}\"",
    "e2e": "nx run-many -t e2e --all",
    "graph": "nx graph",
    "protocol:generate": "nx run protocol:generate",
    "protocol:check": "nx run protocol:check",
    "publish:libs": "node tools/publish-libs.mjs",
    "ci": "prettier --check . && npm run lint:tokens && nx run-many -t lint typecheck test --all && nx run protocol:check && nx run-many -t build --all"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.0.0",
    "@nx/devkit": "23.0.0",
    "@nx/eslint": "23.0.0",
    "@nx/eslint-plugin": "23.0.0",
    "@nx/js": "23.0.0",
    "@nx/playwright": "23.0.0",
    "@nx/vite": "23.0.0",
    "@nx/vitest": "23.0.0",
    "@nx/web": "23.0.0",
    "@nx/workspace": "23.0.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~21.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~21.2.0",
    "nx": "23.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "rv": "workspace:*",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/cdk-experimental": "~21.2.14",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0"
  }
}

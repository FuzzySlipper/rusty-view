{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@rusty-view/protocol": ["./libs/protocol/src/index.ts"],
      "@rusty-view/transport": ["./libs/transport/src/index.ts"],
      "@rusty-view/chat-domain": ["./libs/chat-domain/src/index.ts"],
      "@rusty-view/design-tokens": ["./libs/design-tokens/src/index.ts"],
      "@rusty-view/testing-fixtures": ["./libs/testing-fixtures/src/index.ts"],
      "@rusty-view/chat-store": ["./libs/chat-store/src/index.ts"],
      "@rusty-view/transcript-renderer": [
        "./libs/transcript-renderer/src/index.ts"
      ],
      "@rusty-view/chat-components": ["./libs/chat-components/src/index.ts"],
      "@rusty-view/chat-shell": ["./libs/chat-shell/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

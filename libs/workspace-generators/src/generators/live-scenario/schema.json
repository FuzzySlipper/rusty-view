{
  "$schema": "https://json-schema.org/schema",
  "title": "rv:live-scenario options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Scenario name, e.g. 'reasoning-regression'.",
      "$default": "$name"
    },
    "tags": {
      "type": "string",
      "description": "Additional Playwright title tags, e.g. '@reasoning @controls'.",
      "default": "@generated"
    }
  },
  "required": ["name"]
}

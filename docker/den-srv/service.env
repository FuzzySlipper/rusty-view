RUSTY_CREW_DATA_DIR=/srv/rusty-eva
RUSTY_CREW_DEPLOYMENT_ROLE=production
RUSTY_CREW_CONFIG_DIR=/srv/rusty-eva/config
RUSTY_CREW_ENGINE_DATA_DIR=/srv/rusty-eva/data/engine
RUSTY_CREW_LOG_DIR=/srv/rusty-eva/logs
RUSTY_CREW_RUN_DIR=/srv/rusty-eva/run
RUSTY_CREW_ARTIFACT_DIR=/srv/rusty-eva/artifacts
RUSTY_CREW_BACKUP_DIR=/srv/rusty-eva/backups
RUSTY_CREW_STATIC_DIR=/opt/rusty-view/site
RUSTY_CREW_DEFAULT_WORKDIR=/workspace

RUSTY_CREW_ADMIN_HOST=0.0.0.0
RUSTY_CREW_ADMIN_PORT=9347
RUSTY_CREW_ADMIN_ALLOW_LAN=true
RUSTY_CREW_ADMIN_AUTH_MODE=none

RUSTY_CREW_REVIEW_DEN_AUTHORITY_ID=den-srv-review-operator
RUSTY_CREW_REVIEW_DEN_ENDPOINT_REF=http://192.168.1.10:5199/mcp
RUSTY_CREW_REVIEW_DEN_AUDIT_IDENTITY=rusty-eva-review-operator

RUSTY_CREW_STORAGE_BACKEND=sqlite
RUSTY_CREW_SQLITE_PATH=coordination.sqlite3
RUSTY_CREW_SQLITE_WAL=true
RUSTY_CREW_SQLITE_BUSY_TIMEOUT_MS=5000

RUSTY_CREW_SCHEDULER_TICK_INTERVAL_MS=1000
RUSTY_CREW_WAKE_DISPATCH_INTERVAL_MS=250
